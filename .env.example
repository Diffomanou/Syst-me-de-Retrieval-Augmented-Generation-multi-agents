# ════════════════════════════════════════════════════════
# CONFIGURATION — Multi-Agent RAG (100% GRATUIT)
# ════════════════════════════════════════════════════════

# ── Groq (LLM gratuit) ─────────────────────────────────
# 1. Créer un compte GRATUIT sur https://console.groq.com
# 2. Aller dans API Keys → Create API Key
# 3. Coller la clé ici
GROQ_API_KEY=gsk_...

# ── Neo4j ──────────────────────────────────────────────
# Laisser ces valeurs si vous utilisez docker-compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ── Application ────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ── Modèle LLM Groq (gratuit) ──────────────────────────
# Options disponibles gratuitement :
#   llama-3.1-8b-instant   (rapide)
#   llama-3.1-70b-versatile (plus intelligent, limite/min plus basse)
#   mixtral-8x7b-32768     (bon pour le raisonnement)
LLM_MODEL=llama-3.1-8b-instant

# ── Embeddings HuggingFace (local, 0€) ─────────────────
# Le modèle est téléchargé une seule fois (~120 Mo)
# Supporte le français et l'anglais
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── ChromaDB ───────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents
